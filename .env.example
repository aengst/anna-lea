# ===========================================
# Nya anna-lea.com – Miljövariabler
# Kopiera denna fil till .env och fyll i dina värden
# ===========================================

# Server
PORT=3004
NODE_ENV=development
FRONTEND_URL=https://anna-lea-dev.minaloggar.se

# Databas (PostgreSQL)
# Antingen anges DATABASE_URL (t.ex. i molntjänster) eller DB_HOST/DB_PORT/... nedan.
DB_HOST=192.168.0.121
DB_PORT=5440
DB_USER=annalea_user
DB_PASSWORD=byt_till_starkt_losenord
DB_NAME=annalea_dev
# DATABASE_URL=postgres://annalea_user:losenord@db:5432/annalea_prod

# Google OAuth (för inloggning till /admin)
GOOGLE_CLIENT_ID=din-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=din-google-client-secret
AUTH_REDIRECT_URI=https://anna-lea-dev.minaloggar.se/api/auth/callback

# Säkerhet & Admin
# Generera t.ex. med: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=byt_till_lang_slumpad_hemlighet
# Grund-administratör (kan aldrig låsas ute; fler admins läggs till i /admin)
INITIAL_ADMIN_EMAIL=din.epost@gmail.com

# Media-uppladdning (sökväg inne i servern / lokalt)
UPLOAD_PATH=./uploads

# ZBook / Docker Compose (Portainer)
HOST_UPLOADS_DIR=/home/anders/srv/anna-lea/uploads
HOST_DB_DIR=/home/anders/srv/anna-lea/db
CLOUDFLARE_TUNNEL_TOKEN=din-cloudflare-tunnel-token
